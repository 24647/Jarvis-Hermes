# Jarvis-Hermes configuration template
# NEVER commit real credentials.

# Primary cloud provider (initial target: OpenRouter)
# OPENROUTER_API_KEY=

# Optional cloud speech-to-text provider (only if enabled later)
# GROQ_API_KEY=

# Runtime preferences
JARVIS_NAME=Jarvis
JARVIS_CLOUD_ONLY=true
JARVIS_LOCAL_LLM=false
